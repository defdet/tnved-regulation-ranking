# Development artifacts, not part of the deliverable
work/

# Model weights (7.9 GB) — regenerated by `python prepare_models.py`.
# model_lock.json lives at the solution root precisely so the pinned commit
# SHAs survive without shipping the cache.
solution/models/

# The original drop: assignment.pdf plus a byte-identical copy of the three
# input files. The data itself IS in the repo, at solution/data/, which is what
# `run.py --data ./data` reads; committing initial_data/ too would only add a
# 16 MB duplicate alongside the PDF.
initial_data/

# Credentials must never be committed
**/kaggle.json
**/api_token
*.pem
.env

__pycache__/
*.pyc

# NOTE: solution/out/predictions.csv IS a required deliverable and is tracked.

# Third-party harness with its own git history — never part of this repo
kaggle-harness/

# Local working environment, not the deliverable: MCP server registration,
# Claude Code settings, and the Colab loopback-bridge tooling.
.claude/
.mcp.json
tools/
